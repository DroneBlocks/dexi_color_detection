<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dexi_color_detection</name>
  <version>0.2.0</version>
  <description>HSV color detection ROS2 node for DEXI. Subscribes to compressed camera images and publishes color detections on /color_detections. Works with Node-RED via rosbridge and with Python subscribers.</description>
  <maintainer email="db@droneblocks.io">Dennis Baldwin</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>dexi_interfaces</depend>

  <!-- rclpy + python3-opencv are only needed by the desktop simulator -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
